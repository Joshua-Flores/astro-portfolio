---
import '~/styles/global.css'
import '~/styles/markdown.css'
import '~/styles/lqip.css'
import '~/styles/github-card.css'
import { SITE } from '~/config'
import Head from '~/components/base/Head.astro'
import Header from './Header.astro'
import Footer from './Footer.astro'

type Props = {
  title: string
  description: string
  image?: string
  rawTitle?: boolean
  jsonLd?: Record<string, unknown> | Record<string, unknown>[]
}

const { title, description, image, rawTitle, jsonLd }: Props = Astro.props
const finalTitle = rawTitle ? title : `${title} | ${SITE.title}`
---

<!doctype html>
<html lang={SITE.lang} transition:name="root" transition:animate={SITE.transition ? 'fade' : 'none'}>
  <head>
    <Head title={finalTitle} {description} {image} {jsonLd} />
  </head>
  <body class="flex flex-col">
    <Header />
    <div class="grow flex">
      <main class="relative border-x border-divider/50 global-layout-width mx-auto grow min-w-0">
        <slot />
      </main>
    </div>
    <Footer />
  </body>
</html>
